# Server Configuration
PORT=3000

# JWT Configuration
JWT_VERIFY_SECRET=your_secret_key_here

# Development Settings
NODE_ENV=development


# ----------------------------------------------------------------------------------------------
# Implementation variant flags
# You can use these flags to enable or disable certain behaviors in the implementation, for testing purposes.
# 
# CONFORMANCE_IMPL_DELAY=5000               # delay in ms before sending event callbacks
# CONFORMANCE_IMPL_RELATIVE_LINKS=true      # will cause /footprints to return a Link header with relative URLs instead of absolute
# CONFORMANCE_IMPL_OPENID_CONNECT=true      # expose /.well-known/openid-configuration and use OIDC discovery when calling back

# Conformance Bug Flags (set to "true" to enable)
# You can use these flags to enable certain "bugs" in the implementation, for testing purposes.
#
# CONFORMANCE_BUG_FOOTPRINTS_SCHEMA=true    # /footprints returns footprints missing the required 'created' field
# CONFORMANCE_BUG_AUTH_FORMAT=true          # /auth/token returns HTTP 400 with wrong body format instead of 200 + access_token
# CONFORMANCE_BUG_FOOTPRINT_NOT_FOUND=true  # /footprints/:id returns { error: "..." } instead of { code: "...", message: "..." } on 404

# ----------------------------------------------------------------------------------------------
# You can include a self-signed certificate and key for testing purposes
#
# To generate a self-signed certificate and key, you can use the following command:
#   openssl req -x509 -nodes -days 365 -newkey rsa:2048 -keyout ./selfsigned.key -out selfsigned.crt
#
# You can then set the paths to these files in your environment variables:
# 
# SSL_CERTIFICATE_FILE=./selfsigned.crt
# SSL_KEY_FILE=./selfsigned.key
#
# Alternatively, you can directly include the certificate and key in the .env file. 
# Copy the contents of your certificate and key files into the following variables:
#
# SSL_CERTIFICATE="-----BEGIN CERTIFICATE-----
# ...
# -----END CERTIFICATE-----"
#
# SSL_KEY="-----BEGIN PRIVATE KEY-----
# ...
# -----END PRIVATE KEY-----"

